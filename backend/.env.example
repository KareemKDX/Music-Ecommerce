#For localhost
PORT=
#-----------------------------------------------------------------------

#DATABASE
MYSQL_DATABASE_HOST=
MYSQL_DATABASE_PORT=
MYSQL_DATABASE_USER=
MYSQL_DATABASE_PASSWORD=
JWT_SECRET=


#--------------------------------------------------------------
#PRODUCT SUPPLIER API
SUPPLIER_API_URL=
SUPPLIER_API_KEY=


#--------------------------------------------------------------
# ALGOLIA SEARCH ENGINE
# Algolia: dashboard.algolia.com → Settings → API Keys
ALGOLIA_APP_ID=
# Admin API Key: may WRITE to the index. Secret – only on the server, never in React or in git.
ALGOLIA_ADMIN_KEY=
# Search API Key: may only search.
ALGOLIA_SEARCH_KEY=
# Its own index, so the walkthrough doesn't overwrite the index your shop uses.
ALGOLIA_INDEX=products

#--------------------------------------------------------------
# Stripe Payment
STRIPE_SECRET_KEY=
## Webhook signing secret: needed as soon as the server RECEIVES webhooks – locally too.
## The server starts without it, and hosted/embedded payments work, but the webhook answers 400
##and no order is ever marked as paid.
## - Locally: Stripe can't reach localhost, so `stripe listen` forwards the events.
##   No webhook to create in the Dashboard. Use the whsec_... it prints (the same every time).
##   To only show the secret, without starting to listen: stripe listen --print-secret
## - Deployed: Stripe calls your public URL directly. Use the whsec_... shown on your
##   webhook endpoint in the Stripe Dashboard – a DIFFERENT one than the CLI's.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the customer back after paying (the React app)
#With localhost use localhost url provided by React
CLIENT_URL=

#--------------------------------------------------------------
##SUPABASE FOR PRODUCT CONTAINER (ADDING IMAGES AS ADMIN TO PRODUCTS)
SUPABASE_URL = 
SUPABASE_SECRET_KEY = 
SUPABASE_PASSWORD= 
SUPABASE_BUCKET=

#--------------------------------------------------------------
##FOR POSTNORD DELIVERY OPTIONS (CREATE ACCOUNT IN POSTNORDS DEVELOPER WEBSITE)
POSTNORD_API_KEY=
SHOP_POSTAL_CODE=

#--------------------------------------------------------------
# GOOGLE LOGIN (console.cloud.google.com → APIs & Services → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
# Secret – only on the server, never in React or in git.
GOOGLE_CLIENT_SECRET=
# Where Google sends the user back. Must ALSO be added under "Authorized redirect URIs" in Google Cloud.
# - Locally:  http://localhost:3000/api/auth/google/callback
# - Deployed: https://<your-backend>.vercel.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=
# Signs the one-time login code (valid 60 s) that React swaps for the normal JWT.
# Any long random string, NOT the same as JWT_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# After Google login the user is sent back to CLIENT_URL (above).
SESSION_TOKEN_SECRET=